{
  "name": "claude-hub",
  "version": "0.1.0",
  "description": "Centralized tool call hub for multi-agent Claude Code orchestration",
  "type": "module",
  "bin": {
    "claude-hub": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:tui": "tsx src/tui/index.tsx",
    "start:server": "node dist/server.js",
    "start:tui": "node dist/tui.js",
    "install-hook": "node dist/install.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "react": "^18.2.0",
    "ws": "^8.16.0",
    "chalk": "^5.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
